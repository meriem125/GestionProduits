@page
@model MonProjetFac.Pages.CreateModel
@{
    ViewData["Title"] = "Ajouter un Produit";
}

<h2>Ajouter un Nouveau Produit</h2>

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="Produit.Nom" class="control-label">Nom du Produit</label>
        <input asp-for="Produit.Nom" class="form-control" />
        <span asp-validation-for="Produit.Nom" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Produit.Prix" class="control-label">Prix (DT)</label>
        <input asp-for="Produit.Prix" class="form-control" />
        <span asp-validation-for="Produit.Prix" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Produit.CategorieId" class="control-label">Catégorie</label>
        <select asp-for="Produit.CategorieId" asp-items="Model.Categories" class="form-select"></select>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Produit.Stock" class="control-label">Stock</label>
        <input asp-for="Produit.Stock" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Enregistrer</button>
    <a asp-page="Produits" class="btn btn-secondary">Retour à la liste</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}